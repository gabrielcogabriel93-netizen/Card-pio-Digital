# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL (for production, use your Vercel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (new order notifications, works even with the panel closed).
# Generate once with `npx web-push generate-vapid-keys` and reuse the
# same pair in every environment.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:you@example.com

# Shared secret between the database trigger (migration 014) and the
# /api/push/send route — random string, generate your own.
PUSH_TRIGGER_SECRET=your-random-secret-here

# Mercado Pago (automatic Pix payment with marketplace split, migration 026).
# Client ID/Secret come from a Mercado Pago Developers application
# configured as "Marketplace" (required for the application_fee split).
# Redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/mercadopago/oauth/callback
# Webhook URL to register:  {NEXT_PUBLIC_APP_URL}/api/mercadopago/webhook
MERCADOPAGO_CLIENT_ID=your-mercadopago-client-id
MERCADOPAGO_CLIENT_SECRET=your-mercadopago-client-secret
# Secret shown next to the webhook URL in the Mercado Pago Developers panel
# — used to validate the x-signature header on every webhook call.
MERCADOPAGO_WEBHOOK_SECRET=your-mercadopago-webhook-secret

# Shared secret between the pg_cron job (migration 029) and the
# /api/cron/advance-orders route — random string, generate your own.
# Powers the opt-in "automatic" order status progression.
CRON_TRIGGER_SECRET=your-random-secret-here
