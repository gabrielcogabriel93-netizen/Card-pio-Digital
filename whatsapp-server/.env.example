PORT=3333
# Mesmo valor de WHATSAPP_SERVER_SECRET nas variáveis de ambiente do app Next.js.
API_SECRET=troque-por-uma-string-aleatoria-longa

# Opcional — só em VPS ARM (ex: Oracle Cloud Ampere A1), onde o Chromium
# baixado automaticamente pelo WPPConnect não existe pra essa arquitetura.
# Aponte pro Chromium instalado via apt (ver README, passo de instalação).
# Em x86_64 (a maioria das VPS), deixe comentado/vazio.
# CHROMIUM_PATH=/usr/bin/chromium-browser
